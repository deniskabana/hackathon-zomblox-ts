{
  "name": "zomblocks",
  "version": "0.2.0-beta.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "yarn run build && wrangler dev",
    "format:prettier": "prettier --write .",
    "format:lint": "eslint . --fix --max-warnings=0",
    "format": "yarn format:prettier && yarn format:lint",
    "deploy": "yarn run build && wrangler deploy"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.37.1",
    "@eslint/css": "^0.11.1",
    "@eslint/js": "^9.37.0",
    "@eslint/json": "^0.13.2",
    "eslint": "^9.37.0",
    "globals": "^16.4.0",
    "jiti": "^2.6.1",
    "lefthook": "^1.13.6",
    "lil-gui": "^0.21.0",
    "prettier": "3.6.2",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.45.0",
    "typescript-plugin-css-modules": "^5.2.0",
    "vite": "^7.1.7",
    "wrangler": "^4.92.0"
  },
  "packageManager": "yarn@4.10.3",
  "stableVersion": "0.2.0-beta.0"
}
